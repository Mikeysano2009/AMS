programa {
  funcao inicio() {
    // Declarar as variáveis inteiras
    inteiro n1, n2, soma

    // Pedir os dados ao usuário
    escreva("Digite o primeiro número inteiro: ")
    leia(n1)

    escreva("Digite o segundo número inteiro: ")
    leia(n2)

    // Fazer o cálculo
    soma = n1 + n2

    // Mostrar o resultado
    escreva("A soma dos números é: ", soma)
  }
}

